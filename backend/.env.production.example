APP_NAME=SSC Prep Platform
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

# Supply real values through the deployment secret manager.
# Never commit a populated .env or client secret.
DATABASE_URL=postgresql+psycopg://<user>:<percent-encoded-password>@<host>:5432/<database>?sslmode=verify-full
SECRET_KEY=<unique-random-secret-at-least-32-characters>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=ssc-prep-platform
JWT_AUDIENCE=ssc-prep-web

# Catalog scope remains enabled; it controls visible content, not access.
BETA_CATALOG_SCOPE=true
RATE_LIMIT_CLEANUP_SECONDS=900

# Tune for the total worker count and the PostgreSQL connection budget.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
WEB_CONCURRENCY=2

# For Render's managed public Web Service proxy, set this to '*'.
# For any other host, configure the exact trusted proxy IPs instead.
FORWARDED_ALLOW_IPS=127.0.0.1

# JSON list of exact HTTPS frontend origins.
CORS_ORIGINS=["https://prep.example.com"]

# Google OAuth. Leave all three blank to disable Google sign-in. If enabled,
# set every value in the deployment secret manager; the redirect must be the
# exact backend callback URL registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SUCCESS_REDIRECT_URL=https://prep.example.com/auth/google/complete
GOOGLE_COOKIE_SECURE=true
GOOGLE_COOKIE_SAMESITE=none

# Password setup/recovery. "none" sends nothing and the API says so explicitly.
EMAIL_PROVIDER=none
PASSWORD_RESET_URL=https://prep.example.com/reset-password
PASSWORD_RESET_TTL_SECONDS=1800

# Required only when EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_STARTTLS=true

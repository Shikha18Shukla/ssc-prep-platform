# Reference only. Do not copy this over .env or store a real password here.
# Set DATABASE_URL in the process environment from Neon Console's pooled URL.
DATABASE_URL=postgresql+psycopg://neondb_owner:<percent-encoded-password>@<pooled-endpoint>.neon.tech/neondb?sslmode=require&channel_binding=require

# Small single-worker beta service defaults; adjust only with a connection budget.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

APP_NAME=SSC Prep Platform
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Database — psycopg v3 dialect
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=ssc-prep-platform
JWT_AUDIENCE=ssc-prep-web

# Google OAuth. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:5173/auth/google/complete
GOOGLE_COOKIE_SECURE=false
GOOGLE_COOKIE_SAMESITE=lax

# Password setup/recovery. "none" sends nothing and reports that no email was sent.
EMAIL_PROVIDER=none
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TTL_SECONDS=1800
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_STARTTLS=true

# CORS
CORS_ORIGINS=["http://localhost:5173"]

APP_NAME=SSC Prep Platform
APP_VERSION=0.1.0
DEBUG=True

# Database — psycopg v3 dialect
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ssc_prep

# JWT Authentication (Stage 3+)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173"]
